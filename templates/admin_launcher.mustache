<div class="savio-admin-launcher text-center" style="padding: 1.25rem 1rem; border: 1px solid #fde4ce; border-radius: 14px; background: linear-gradient(145deg, #fffdfa 0%, #fff2e7 100%); box-shadow: 0 8px 20px rgba(255, 102, 0, .10);">
    <div style="margin: 0 auto .85rem; line-height: 0;">{{{icon_html}}}</div>
    <div class="small font-weight-bold text-uppercase" style="letter-spacing: .07em; color: #cc5200;"><i class="fa fa-lock mr-1"></i>{{security_label}}</div>
    <h6 class="mt-2 mb-2 font-weight-bold">{{title}}</h6>
    <a href="{{admin_url}}" class="btn btn-sm btn-block" style="background: linear-gradient(135deg, #ff7a1a 0%, #e85d00 100%); color: #fff !important; border: 0; font-weight: 700; border-radius: 8px;"><i class="fa fa-arrow-right mr-1"></i>{{button_label}}</a>
</div>
